<?xml version='1.0' encoding='utf-8'?>
<resources>
    <!--
    Light scheme. Dark values live in values-night/colors.xml. Every theme color here mirrors
    ui/theme/NsPalette.kt (the Compose side); XmlComposeColorParityTest keeps the two in step.
    Colors that only point at a role (normalText and friends) are defined once, here, and pick up
    the right value per qualifier through the reference.
    -->

    <!-- Material 3 roles, Slate accent -->
    <color name="md_theme_primary">#3F5178</color>
    <color name="md_theme_onPrimary">#FFFFFF</color>
    <color name="md_theme_primaryContainer">#E9EDF6</color>
    <color name="md_theme_onPrimaryContainer">#3F5178</color>
    <color name="md_theme_secondary">#3F5178</color>
    <color name="md_theme_onSecondary">#FFFFFF</color>
    <color name="md_theme_secondaryContainer">#E9EDF6</color>
    <color name="md_theme_onSecondaryContainer">#3F5178</color>
    <color name="md_theme_tertiary">#18753A</color>
    <color name="md_theme_onTertiary">#FFFFFF</color>
    <color name="md_theme_tertiaryContainer">#E6F4EA</color>
    <color name="md_theme_onTertiaryContainer">#0D5A28</color>
    <color name="md_theme_error">#C62828</color>
    <color name="md_theme_onError">#FFFFFF</color>
    <color name="md_theme_errorContainer">#FDE8E7</color>
    <color name="md_theme_onErrorContainer">#8C1D18</color>
    <color name="md_theme_background">#F2F4F7</color>
    <color name="md_theme_onBackground">#1B1F26</color>
    <color name="md_theme_surface">#F2F4F7</color>
    <color name="md_theme_onSurface">#1B1F26</color>
    <color name="md_theme_surfaceVariant">#E3E6EB</color>
    <color name="md_theme_onSurfaceVariant">#5B6372</color>
    <color name="md_theme_outline">#8A93A0</color>
    <color name="md_theme_outlineVariant">#E3E6EB</color>
    <color name="md_theme_inverseSurface">#2A2F36</color>
    <color name="md_theme_inverseOnSurface">#F2F4F7</color>
    <color name="md_theme_inversePrimary">#8FA5DB</color>
    <color name="md_theme_surfaceDim">#DCE0E6</color>
    <color name="md_theme_surfaceBright">#FFFFFF</color>
    <color name="md_theme_surfaceContainerLowest">#FFFFFF</color>
    <color name="md_theme_surfaceContainerLow">#FFFFFF</color>
    <color name="md_theme_surfaceContainer">#FFFFFF</color>
    <color name="md_theme_surfaceContainerHigh">#ECEFF3</color>
    <color name="md_theme_surfaceContainerHighest">#E3E6EB</color>

    <!-- Fixed roles are the same in both schemes, so they have no night override -->
    <color name="md_theme_primaryFixed">#E9EDF6</color>
    <color name="md_theme_onPrimaryFixed">#1B1F26</color>
    <color name="md_theme_primaryFixedDim">#B4C4EA</color>
    <color name="md_theme_onPrimaryFixedVariant">#3F5178</color>
    <color name="md_theme_secondaryFixed">#E9EDF6</color>
    <color name="md_theme_onSecondaryFixed">#1B1F26</color>
    <color name="md_theme_secondaryFixedDim">#B4C4EA</color>
    <color name="md_theme_onSecondaryFixedVariant">#3F5178</color>
    <color name="md_theme_tertiaryFixed">#E6F4EA</color>
    <color name="md_theme_onTertiaryFixed">#0D5A28</color>
    <color name="md_theme_tertiaryFixedDim">#9BE3AE</color>
    <color name="md_theme_onTertiaryFixedVariant">#18753A</color>

    <!-- Per-record-type colors (NsPalette.Protocol) -->
    <color name="ns_protocol_cellular">#6D4DE0</color>
    <color name="ns_protocol_phone_state">#D99A00</color>
    <color name="ns_protocol_wifi">#0E9BB0</color>
    <color name="ns_protocol_bluetooth">#2F6BFF</color>
    <color name="ns_protocol_gnss">#1E8E3E</color>
    <color name="ns_protocol_cdr">#D9486B</color>

    <!-- Status colors (NsPalette.Status) -->
    <color name="ns_status_success">#1E8E3E</color>
    <color name="ns_status_success_container">#E6F4EA</color>
    <color name="ns_status_warning">#B26A00</color>
    <color name="ns_status_warning_container">#FFF3E0</color>
    <color name="ns_status_danger">#C62828</color>
    <color name="ns_status_danger_container">#FDE8E7</color>

    <!-- Survey-state vocabulary (NsSurveyStateColors), shared with the notification -->
    <color name="ns_state_ready">@color/md_theme_onPrimaryContainer</color>
    <color name="ns_state_ready_container">@color/md_theme_primaryContainer</color>
    <color name="ns_state_recording">@color/ns_status_success</color>
    <color name="ns_state_recording_container">@color/ns_status_success_container</color>
    <color name="ns_state_paused">@color/ns_status_warning</color>
    <color name="ns_state_paused_container">@color/ns_status_warning_container</color>
    <color name="ns_state_attention">@color/ns_status_danger</color>
    <color name="ns_state_attention_container">@color/ns_status_danger_container</color>

    <!-- Legacy names still used by View screens, pointed at the roles they stand for -->
    <color name="colorAccent">@color/md_theme_primary</color>
    <color name="colorCardDarkTitle">@color/md_theme_primaryContainer</color>
    <color name="activeTabColor">@color/md_theme_primary</color>
    <color name="normalText">@color/md_theme_onSurface</color>
    <color name="fadedText">@color/md_theme_onSurfaceVariant</color>
    <color name="body_text_1_dark">@color/md_theme_onSurface</color>
    <color name="connectionStatusDisconnected">@color/ns_status_danger</color>
    <color name="connectionStatusConnecting">@color/ns_status_warning</color>
    <color name="connectionStatusConnected">@color/ns_status_success</color>
    <color name="alert_red">@color/ns_status_danger</color>
    <color name="signalBarBackground">#00FFFFFF</color>

    <!-- Wi-Fi & Bluetooth RSSI color ranges (NsPalette.Signal), the same in both schemes -->
    <color name="rssi_green">#388E3C</color>
    <color name="rssi_yellow">#FBC02D</color>
    <color name="rssi_orange">#F57C00</color>
    <color name="rssi_red">#D32F2F</color>
    <color name="rssi_deep_red">#D50000</color>

    <!-- GNSS Sky View -->
    <color name="body_text_2_light">#8a000000</color>
    <!-- Satellites seen but not in view: a translucent gray on the light sky disc -->
    <color name="not_in_view_sat">#998A93A0</color>
    <color name="gray">#ff888888</color>
    <color name="red">#d50000</color>
    <color name="yellow">#ffb300</color>
    <color name="green">#009d00</color>

    <color name="cn0_meter_border">@color/md_theme_outline</color>

    <!-- Tower map markers (chosen by the map style, not the app theme) -->
    <color name="general_tower_dark">#DEE3E6</color>
    <color name="serving_cell_dark">#4DA6FF</color>
    <color name="general_tower_light">#606060</color>
    <color name="serving_cell_light">#005CBF</color>

    <color name="serving_cell_line">#80CFFF</color>

    <!-- Coverage Circle Color Options -->
    <color name="coverage_circle_red">#FF4444</color>
    <color name="coverage_circle_green">#4CAF50</color>
    <color name="coverage_circle_orange">#FF9800</color>
    <color name="coverage_circle_purple">#9C27B0</color>
    <color name="coverage_circle_yellow">#FFEB3B</color>
    <color name="coverage_circle_cyan">#00BCD4</color>
    <color name="coverage_circle_white">#FFFFFF</color>

    <!-- AirTag indicator color -->
    <color name="airtag_purple">#BA68C8</color>
</resources>
