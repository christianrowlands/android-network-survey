<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/sourceAddress"
            style="@style/ListTitleText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/xx_small_margin"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="" />

        <TextView
            android:id="@+id/bluetooth_signal_strength"
            style="@style/ListTitleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/xx_small_margin"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="" />

    </LinearLayout>

    <com.google.android.flexbox.FlexboxLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/xx_small_margin"
        android:paddingTop="@dimen/xx_small_margin"
        android:paddingEnd="@dimen/xx_small_margin"
        android:paddingBottom="@dimen/xx_small_margin"
        app:alignItems="center"
        app:dividerDrawableHorizontal="@drawable/flex_line_spacer"
        app:flexWrap="wrap"
        app:showDividerHorizontal="middle">

        <!-- Group: Company Name + trailing separator. Each group below is its own flex
             item so a row that is too wide wraps at group boundaries instead of
             squeezing the text into a narrow column. The weight on the name lets this
             layout take any width deficit out of the name (which ellipsizes) instead of
             clipping the trailing separator, so keep the weight suppression. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/companyName"
                style="@style/ListContentText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text=""
                tools:ignore="InefficientWeight" />

            <TextView
                android:id="@+id/companySeparator"
                style="@style/ListContentText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:text="|"
                android:textColor="@color/md_theme_primary"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <!-- Group: AirTag indicator + trailing separator. The wrapper stays visible but
             measures zero width when its children are gone. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/airTagIndicator"
                style="@style/ListContentText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/airtag"
                android:textColor="@color/airtag_purple"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/airTagSeparator"
                style="@style/ListContentText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:text="|"
                android:textColor="@color/md_theme_primary"
                android:visibility="gone"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <!-- Group: Device Name label + value. The value is the last child, so it is
             measured against the width remaining after the label and ellipsizes. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/otaDeviceLabel"
                style="@style/ListLabelText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/device_name" />

            <TextView
                android:id="@+id/otaDeviceName"
                style="@style/ListContentText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="" />
        </LinearLayout>

        <!-- Supported technologies. flexGrow absorbs the line's free space and
             gravity=end pins the text right, both when sharing a line and when wrapped
             to its own line. paddingStart guarantees a minimum gap on a packed line. -->
        <TextView
            android:id="@+id/supportedTechnologies"
            style="@style/ListContentText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:maxLines="1"
            android:paddingStart="@dimen/large_margin"
            android:text=""
            app:layout_flexGrow="1"
            tools:ignore="RtlSymmetry" />
    </com.google.android.flexbox.FlexboxLayout>


</LinearLayout>
